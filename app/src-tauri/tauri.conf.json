{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Deck",
  "mainBinaryName": "agent-deck",
  "version": "0.2.0",
  "identifier": "de.idm.agentdeck",
  "build": {
    "beforeDevCommand": "pnpm helpers && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm helpers:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
